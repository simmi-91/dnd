# Kopier til apps/server/.env for lokal utvikling. I produksjon ligger filen i /var/www/dnd/.env.
# Aldri legg ekte verdier i git.

NODE_ENV=development
PORT=8032

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=development_db

# Google OAuth-klient (Web). Tom = Google-innlogging er av (dev-login kan brukes lokalt).
GOOGLE_CLIENT_ID=

# Hvor lenge en sesjon varer, i dager. Forlenges ved bruk.
SESSION_TTL_DAYS=60

# Hvor lenge svar fra D&D Beyond bufres i minnet, i sekunder (fase 2).
DDB_CACHE_SECONDS=300

# Bygd nettside som Fastify skal servere (produksjon: /var/www/dnd/client). Tom lokalt (Vite serverer).
WEB_DIR=

# Opplastede bilder (senere). Produksjon: /var/www/dnd/img
IMAGE_DIR=

# Lokal innlogging uten Google: GET /api/auth/dev-login. Virker aldri når NODE_ENV=production.
DEV_LOGIN_EMAIL=

# Testdatabasen som Vitest bruker (lages hvis den mangler). DB_NAME brukes aldri av testene.
TEST_DB_NAME=dnd_test
